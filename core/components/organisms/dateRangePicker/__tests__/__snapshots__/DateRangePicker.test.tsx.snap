exports[`DateRangePicker component 
  open: true, size: "small", withInput: true, rangeLimit: 7, view: "year"
 1`] = `
<body>
  <div>
    <div
      class="w-100"
    >
      <div
        aria-controls=":r1d:"
        aria-expanded="true"
        aria-haspopup="dialog"
        class="w-100"
        data-state="open"
      >
        <div
          class="Row"
          data-test="DesignSystem-DateRangePicker-InputTrigger"
        >
          <div
            class="Col Col--6 Col--xs-12 DateRangePicker-input DateRangePicker-input--startDate"
            data-test="DesignSystem-Column"
          >
            <div
              class="Label Label--withInput"
              data-test="DesignSystem-Label"
            >
              <label
                class="Label-text"
                data-test="DesignSystem-Label--Text"
                for="DesignSystem-DateRangePicker-startInput-Test-uid"
              >
                Start Date
              </label>
            </div>
            <div
              class="d-flex flex-column flex-grow-1"
              data-test="DesignSystem-InputMask--Wrapper"
            >
              <div
                class="Input Input--regular"
                data-test="DesignSystem-InputWrapper"
                role="presentation"
                style="min-width: 256px;"
              >
                <div
                  class="Input-icon Input-icon--left"
                >
                  <i
                    aria-hidden="true"
                    class="material-symbols material-symbols-rounded Icon"
                    data-test="DesignSystem-Icon"
                    style="font-size: 16px; width: 16px;"
                  >
                    events
                  </i>
                </div>
                <input
                  aria-label="Start Date"
                  autocomplete="off"
                  class="Input-input Input-input--regular mr-4"
                  data-test="DesignSystem-Input"
                  id="DesignSystem-DateRangePicker-startInput-Test-uid"
                  placeholder="mm/dd/yyyy"
                  type="text"
                  value="03/03/2020"
                />
                <div
                  aria-label="Clear Start Date"
                  class="Input-icon Input-iconWrapper--right"
                  role="button"
                  tabindex="0"
                >
                  <i
                    aria-hidden="true"
                    class="material-symbols material-symbols-rounded Icon Input-icon--right p-3"
                    data-test="DesignSystem-Input--closeIcon"
                    style="font-size: 16px; width: 16px;"
                  >
                    close
                  </i>
                </div>
              </div>
            </div>
          </div>
          <div
            class="Col Col--6 Col--xs-12 DateRangePicker-input DateRangePicker-input--endDate"
            data-test="DesignSystem-Column"
          >
