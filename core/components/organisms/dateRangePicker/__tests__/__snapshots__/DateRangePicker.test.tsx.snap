exports[`DateRangePicker component 
  open: true, size: "large", withInput: false, rangeLimit: 7, view: "month"
 1`] = `
<body>
  <div>
    <div
      aria-label="Calendar"
      class="Calendar-wrapper"
      data-test="DesignSystem-Calendar-Wrapper"
    >
      <div
        class="Calendar Calendar-month--large Calendar--large"
        data-calendar-index="0"
        data-test="DesignSystem-Calendar"
      >
        <div
          class="Calendar-header--large"
        >
          <div
            class="Calendar-headerIcon Calendar-headerIcon--prev"
          >
            
            <div
              class="PopperWrapper-trigger"
            >
              <button
                aria-describedby="Tooltip-Test-uid"
                aria-label="Previous year"
                class="Button Button--regular Button--regularSquare Button--basic"
                data-test="DesignSystem-Button"
                tabindex="0"
                type="button"
              >
                <div
                  class="Button-icon"
                  data-test="DesignSystem-Button--Icon-Wrapper"
                >
                  <i
                    aria-hidden="true"
                    class="material-symbols material-symbols-rounded Icon"
                    data-test="DesignSystem-Button--Icon"
                    style="font-size: 16px; width: 16px;"
                  >
                    arrow_back
                  </i>
                </div>
              </button>
            </div>
          </div>
          <div
            class="Calendar-headerContent Calendar-headerContent--noIcon-left Calendar-headerContent--noIcon-right"
          >
            <button
              aria-label="Select year"
              class="Calendar-headerButton"
              type="button"
            >
              <span
                class="Heading Heading--s Heading--default"
                data-test="DesignSystem-Heading"
              >
                2021
              </span>
            </button>
          </div>
          <div
            class="Calendar-headerIcon Calendar-headerIcon--next"
          >
            
            <div
              class="PopperWrapper-trigger"
            >
              <button
                aria-describedby="Tooltip-Test-uid"
                aria-label="Next year"
                class="Button Button--regular Button--regularSquare Button--basic"
                data-test="DesignSystem-Button"
                tabindex="0"
                type="button"
              >
                <div
                  class="Button-icon"
                  data-test="DesignSystem-Button--Icon-Wrapper"
                >
                  <i
                    aria-hidden="true"
                    class="material-symbols material-symbols-rounded Icon"
                    data-test="DesignSystem-Button--Icon"
                    style="font-size: 16px; width: 16px;"
                  >
                    arrow_forward
                  </i>
                </div>
              </button>
            </div>
          </div>
        </div>
        <div
          class="Calendar-body"
          role="grid"
        >
          <div
            class="Calendar-valueRow"
            role="row"
          >
            <div
              class="Calendar-monthValueWrapper"
            >
              <button
                aria-disabled="false"
                aria-label="Jan"
                aria-selected="false"
                class="Calendar-value Calendar-monthValue Calendar-monthValue--large"
                data-calendar-month-cell="true"
                data-month="0"
                data-test="DesignSystem-Calendar--monthValue"
                role="gridcell"
                tabindex="-1"
                type="button"
              >
                <span
                  class="Text Text--regular color-inverse Calendar-text"
                  data-test="DesignSystem-Text"
                >
                  Jan
                </span>
              </button>
            </div>
            <div
              class="Calendar-monthValueWrapper"
            >
              <button
                aria-disabled="false"
                aria-label="Feb"
                aria-selected="false"
                class="Calendar-value Calendar-monthValue Calendar-monthValue--large"
                data-calendar-month-cell="true"
                data-month="1"
                data-test="DesignSystem-Calendar--monthValue"
                role="gridcell"
                tabindex="-1"
                type="button"
              >
                <span
                  class="Text Text--regular color-inverse Calendar-text"
                  data-test="DesignSystem-Text"
                >
                  Feb
                </span>
              </button>
            </div>
            <div
              class="Calendar-monthValueWrapper"
            >
              <button
                aria-disabled="false"
