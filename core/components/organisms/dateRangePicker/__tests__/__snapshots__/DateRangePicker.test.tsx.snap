exports[`DateRangePicker component 
  open: true, size: "large", withInput: false, rangeLimit: 7, view: "month"
 1`] = `
<body>
  <div>
    <div
      aria-label="Calendar"
      class="Calendar-wrapper"
      data-test="DesignSystem-Calendar-Wrapper"
    >
      <div
        class="Calendar Calendar-month--large Calendar--large"
        data-calendar-index="0"
        data-test="DesignSystem-Calendar"
      >
        <div
          class="Calendar-header--large"
        >
          <div
            class="Calendar-headerIcon Calendar-headerIcon--prev"
          >
            <div
              class="w-fit-content"
            >
              <div
                aria-expanded="false"
                aria-haspopup="dialog"
                class="w-fit-content"
                data-state="closed"
