exports[`DateRangePicker component 
  startDate: 1629790081880, endDate: {}, position: "bottom", contentAlign: "left"
 1`] = `
<body>
  <div>
    <div
      aria-label="Calendar"
      class="Calendar-wrapper"
      data-test="DesignSystem-Calendar-Wrapper"
    >
      <div
        class="Calendar Calendar-date--large Calendar--large"
        data-calendar-index="0"
        data-test="DesignSystem-Calendar"
      >
        <div
          class="Calendar-header--large"
        >
          <div
            class="Calendar-headerIcon Calendar-headerIcon--prev"
          >
            <div
              class="w-fit-content"
            >
              <div
                aria-expanded="false"
                aria-haspopup="dialog"
                class="w-fit-content"
                data-state="closed"
              >
                <button
                  aria-label="Previous month"
                  class="Button Button--regular Button--regularSquare Button--basic"
                  data-test="DesignSystem-Button"
                  tabindex="0"
                  type="button"
                >
                  <div
                    class="Button-icon"
                    data-test="DesignSystem-Button--Icon-Wrapper"
                  >
                    <i
                      aria-hidden="true"
                      class="material-symbols material-symbols-rounded Icon"
                      data-test="DesignSystem-Button--Icon"
                      style="font-size: 16px; width: 16px;"
                    >
                      arrow_back
                    </i>
                  </div>
                </button>
              </div>
            </div>
          </div>
          <div
            class="Calendar-headerContent Calendar-headerContent--noIcon-left Calendar-headerContent--noIcon-right"
          >
            <button
              aria-label="Select month"
              class="Calendar-headerButton"
              type="button"
            >
              <span
                class="Heading Heading--s Heading--default"
                data-test="DesignSystem-Heading"
              />
            </button>
            <button
              aria-label="Select year"
              class="Calendar-headerButton ml-4"
              type="button"
            >
              <span
                class="Heading Heading--s Heading--default"
                data-test="DesignSystem-Heading"
              >
                NaN
              </span>
            </button>
          </div>
          <div
            class="Calendar-headerIcon Calendar-headerIcon--next"
          >
            <div
              class="w-fit-content"
            >
              <div
                aria-expanded="false"
                aria-haspopup="dialog"
                class="w-fit-content"
                data-state="closed"
              >
                <button
                  aria-label="Next month"
                  class="Button Button--regular Button--regularSquare Button--basic"
                  data-test="DesignSystem-Button"
                  tabindex="0"
                  type="button"
                >
                  <div
                    class="Button-icon"
                    data-test="DesignSystem-Button--Icon-Wrapper"
                  >
                    <i
                      aria-hidden="true"
                      class="material-symbols material-symbols-rounded Icon"
                      data-test="DesignSystem-Button--Icon"
                      style="font-size: 16px; width: 16px;"
                    >
                      arrow_forward
                    </i>
                  </div>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div
          class="Calendar-body"
          role="grid"
        >
          <div
            class="Calendar-dayValues"
            role="row"
          >
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                Su
              </span>
            </div>
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                Mo
              </span>
            </div>
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                Tu
              </span>
            </div>
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                We
              </span>
            </div>
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                Th
              </span>
            </div>
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                Fr
              </span>
            </div>
            <div
              class="Calendar-valueWrapper"
              role="columnheader"
            >
              <span
                class="Text Text--default Text--strong Text--regular"
                data-test="DesignSystem-Text"
              >
                Sa
              </span>
            </div>
          </div>
          <div
            class="Calendar-dateValues"
            role="rowgroup"
          />
        </div>
      </div>
    </div>
  </div>
